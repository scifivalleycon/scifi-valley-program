{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scifi-valley-program",
  "main": "worker.js",
  "compatibility_date": "2026-08-21",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "services": [
    {
      "binding": "VENDOR_API",
      "service": "scifi-valley-vendor"
    }
  ]
}
