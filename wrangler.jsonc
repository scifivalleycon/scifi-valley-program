{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scifi-valley-admin",
  "main": "worker.js",
  "compatibility_date": "2026-08-13",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "0 13 * * *"
    ]
  }
}
